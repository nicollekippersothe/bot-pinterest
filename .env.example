# ─── Anthropic (Fase 3: copy, SEO e hashtags) ──────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key
ANTHROPIC_MODEL=claude-opus-5

# ─── Telegram (Fase 5) ─────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHANNEL_ID=@seu_canal_de_achadinhos

# ─── Pinterest (Fase 4 — automação via Playwright) ─────────────────────────
PINTEREST_EMAIL=your_email@domain.com
PINTEREST_PASSWORD=your_password
PINTEREST_BOARD_NAME=Achados da Semana

# ─── Mineração (Fase 2) ────────────────────────────────────────────────────
# mock  = payload simulado, não faz rede (padrão, use em desenvolvimento)
# shopee = busca real na Shopee (costuma ser bloqueada fora de IP residencial)
MINER_SOURCE=mock
MINER_KEYWORDS=organizador de cozinha,utensílios de cozinha,decoração para casa
MINER_LIMIT=10
MINER_MIN_DISCOUNT=10
SHOPEE_AFFILIATE_ID=an_18393280814

# ─── Agendamento e infraestrutura ──────────────────────────────────────────
CRON_SCHEDULE=0 */2 * * *
# Caminho do SQLite, relativo à raiz do repositório
DATABASE_PATH=storage/affiliate.db
LOG_LEVEL=info
