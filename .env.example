# ─── Anthropic (Fase 3: copy, SEO e hashtags) ──────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key
ANTHROPIC_MODEL=claude-opus-5

# ─── Telegram (Fase 5) ─────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHANNEL_ID=@seu_canal_de_achadinhos

# ─── Pinterest (Fase 4 — automação via Playwright) ─────────────────────────
PINTEREST_EMAIL=your_email@domain.com
PINTEREST_PASSWORD=your_password
PINTEREST_BOARD_NAME=Achados da Semana

# ─── Mineração (Fase 2) ────────────────────────────────────────────────────
# panel  = CSVs do painel de afiliados — ÚNICA fonte cujos links geram comissão
# mock   = payload simulado, sem rede (padrão para desenvolvimento)
# shopee = busca pública; os links NÃO rastreiam comissão
MINER_SOURCE=mock
MINER_KEYWORDS=organizador de cozinha,utensílios de cozinha,decoração para casa
MINER_LIMIT=10
MINER_MIN_DISCOUNT=10
SHOPEE_AFFILIATE_ID=an_18393280814

# Pasta com os CSVs exportados do painel ("Obter Link em Massa")
PANEL_LINKS_DIR=storage/links
# URL do datafeed — É CREDENCIAL: nunca versione nem compartilhe
SHOPEE_DATAFEED_URL=
DATAFEED_PATH=storage/datafeed.csv

# ─── Agendamento e infraestrutura ──────────────────────────────────────────
CRON_SCHEDULE=0 */2 * * *
# Quantas ofertas publicar por ciclo
PUBLISH_BATCH_SIZE=3
# Caminho do SQLite, relativo à raiz do repositório
DATABASE_PATH=storage/affiliate.db
LOG_LEVEL=info

# ─── Pinterest via feed público (Fase 4) ───────────────────────────────────
# Domínio do seu deploy; os pins ficam em <URL>/pins/ e o feed em <URL>/feed.json
PUBLIC_BASE_URL=https://seu-app.vercel.app
